# TokyoPulse — SECRET plane. Loaded by /api, /ingest, and the Daytona launcher.
# NEVER imported by /web. Copy to .env (gitignored) and fill.
# Every var is consumed by exactly one agent — the "owner" column is the contract.

# ─────────────────────────────────────────────────────────────
# TIER 0 — BLOCKING. No fallback. Must exist before 2:00 PM.
# ─────────────────────────────────────────────────────────────

# Daytona — compute plane. Owner: A2 (ingest launcher).
# app.daytona.io → Keys → Create Key.
DAYTONA_API_KEY=dtn_41cb487f0111b67eeb28c429f0f496e87ca40342252d1a45ddc28d0c9a923fd1
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
DAYTONA_SNAPSHOT=                      # optional prebuilt image w/ deps baked in; empty = default

# Neo4j Aura Free — graph plane. Owner: A3 (schema/seed/API), A2 (writes).
# console.neo4j.io → Create Free instance → DOWNLOAD THE CREDENTIALS FILE (shown once).
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Anthropic — the /brief insurance policy (fallback ladder #1). Owner: A3/A4.
# Get this even if Nosana works. It is the only thing standing between you and a dead BriefCard.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─────────────────────────────────────────────────────────────
# TIER 1 — Has a pre-agreed fallback. 15-minute timebox (arch §6.1).
# ─────────────────────────────────────────────────────────────

# Nosana — LLM serving. Owner: A4.
# Deploy an inference job → it returns a service URL. Treat it as OpenAI-compatible:
# the /brief client takes (base_url, api_key, model) so Nosana→Anthropic is a 1-line swap.
NOSANA_BASE_URL=                       # e.g. https://<job-id>.node.k8s.prd.nos.ci/v1
NOSANA_API_KEY=                        # often unused on public job endpoints — leave blank if so
NOSANA_MODEL=                          # exact model string the deployed server advertises
LLM_PROVIDER=nosana                    # nosana | anthropic  ← the fallback switch, flip at demo time

# ─────────────────────────────────────────────────────────────
# TIER 2 — STRETCH. Approval is ASYNC — apply days early or cut silently.
# ─────────────────────────────────────────────────────────────

ODPT_ACCESS_TOKEN=                     # buses / GTFS-RT only. Core train feed is KEYLESS — never block on this.
CESIUM_ION_TOKEN=                      # only if GSI imagery fails; also needed for PLATEAU-via-ion

# ─────────────────────────────────────────────────────────────
# NON-SECRET RUNTIME CONFIG — pinned here so no agent has to guess a URL.
# ─────────────────────────────────────────────────────────────

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

FEED_ODPT_TRAINS=https://api-public.odpt.org/api/v4/odpt:TrainInformation.json
FEED_P2PQUAKE_WS=wss://api.p2pquake.net/v2/ws
FEED_P2PQUAKE_HISTORY=https://api.p2pquake.net/v2/history?codes=551&limit=20
FEED_JMA_WARNING=https://www.jma.go.jp/bosai/warning/data/warning/130000.json
FEED_OPEN_METEO=https://api.open-meteo.com/v1/forecast?latitude=35.6895&longitude=139.6917&hourly=temperature_2m,precipitation&past_days=2&forecast_days=2&timezone=Asia%2FTokyo

INGEST_POLL_SECONDS=30
MOCK_DIR=./mock
USE_MOCKS=false                        # ladder #7: flip true → whole stack runs offline on cached payloads
