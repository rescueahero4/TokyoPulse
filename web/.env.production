# TokyoPulse - public production build (`vite build`). Everything here IS published.
# Vite gives this file priority over .env.local, so a local build cannot leak local-only values.
# The API is served from the same origin, by the backend service in ../vercel.json.
VITE_USE_MOCKS=false
VITE_API_BASE_URL=/api

# Deliberately blank: the keyless GSI/Esri path needs no token. Set it only if the token is
# restricted to the deployed host in the ion console.
VITE_CESIUM_ION_TOKEN=

VITE_BASEMAP_DEFAULT=gsi-pale
VITE_GSI_STD_TILES=https://cyberjapandata.gsi.go.jp/xyz/std/{z}/{x}/{y}.png
VITE_GSI_PALE_TILES=https://cyberjapandata.gsi.go.jp/xyz/pale/{z}/{x}/{y}.png
VITE_GSI_FLOOD_TILES=https://disaportaldata.gsi.go.jp/raster/01_flood_l2_shinsuishin_data/{z}/{x}/{y}.png
VITE_OSM_FALLBACK_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_BASEMAP_GRAY_TILES=https://services.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}
VITE_BASEMAP_SATELLITE_TILES=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_BASEMAP_GSI_PHOTO_TILES=https://cyberjapandata.gsi.go.jp/xyz/seamlessphoto/{z}/{x}/{y}.jpg
VITE_OVERLAY_GRAY_LABELS_TILES=https://services.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Reference/MapServer/tile/{z}/{y}/{x}
VITE_OVERLAY_LABELS_TILES=https://services.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}
VITE_OVERLAY_LABELS_ALPHA=0.9
VITE_MAP_CENTER_LAT=35.6812
VITE_MAP_CENTER_LON=139.7671
VITE_MAP_HEIGHT_M=40000
VITE_MAP_MIN_ZOOM_M=120
VITE_MAP_MAX_ZOOM_M=30000000
VITE_INTRO_FLIGHT=true
VITE_INTRO_DURATION_S=3.6
VITE_MAP_INTRO_HEIGHT_M=24000000
VITE_MAP_GLOBE_ALTITUDE_M=1000000
VITE_RAIL_SIMPLIFY_M=15
VITE_LABEL_SPACING=0.04
