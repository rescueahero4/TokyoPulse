# TokyoPulse — PUBLIC plane. Owner: A1 only.
# Vite inlines every VITE_* var into the JS bundle. Anything here IS published.
# Rule (arch §8): if leaking it would cost money or data, it does NOT belong in this file.
# Forbidden here, always: NEO4J_PASSWORD, DAYTONA_API_KEY, ANTHROPIC_API_KEY, NOSANA_API_KEY.

VITE_API_BASE_URL=http://localhost:8000

# Cesium ion token — public by design. Restrict it to localhost + your demo host in the ion console.
# Leave blank while GSI imagery works (keyless path is the default).
VITE_CESIUM_ION_TOKEN=

# Keyless tile sources (GSI 国土地理院)
VITE_GSI_STD_TILES=https://cyberjapandata.gsi.go.jp/xyz/std/{z}/{x}/{y}.png
VITE_GSI_PALE_TILES=https://cyberjapandata.gsi.go.jp/xyz/pale/{z}/{x}/{y}.png
VITE_GSI_FLOOD_TILES=https://disaportaldata.gsi.go.jp/raster/01_flood_l2_shinsuishin_data/{z}/{x}/{y}.png
VITE_OSM_FALLBACK_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Camera home — Tokyo Station
VITE_MAP_CENTER_LAT=35.6812
VITE_MAP_CENTER_LON=139.7671
VITE_MAP_HEIGHT_M=40000

# Ladder #7: FE runs 100% on checked-in mocks, API untouched
VITE_USE_MOCKS=false
